<!-- Overlay -->
<div class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50" id="modal-inscription">

    <!-- Conteneur du modal d'inscription -->
    <div class="bg-white rounded-xl p-8 pt-6 w-full max-w-md relative">

        <!-- Entete modal-->
        <div class="flex justify-between items-center mb-4">
            <div class="flex flex-col gap-1">
                <!-- Titre du modal -->
                <h2 class="text-3xl font-semibold">Création du compte</h2>

                <!-- Ligne de séparation -->
                <div class="h-1.5 bg-primary w-[50%]"></div>
            </div>

            <!-- Bouton de fermeture du modal -->
            <button id="close-modal-inscription" class="align-center cursor-pointer">
                <span class="material-symbols-outlined"> close </span>
            </button>
        </div>

        <!-- Formulaire d'inscription -->  
        <form id="form-inscription" class="flex flex-col gap-4">

            <!-- Étape 1: Informations personnelles -->
            <div id="step-1" class="flex flex-col gap-4">
                <div>
                    <label for="last-name" class="block text-md font-medium">Nom</label>
                    <input type="text" id="nom" name="last-name" required class="border rounded p-2 w-full border-gray-300 focus:border-primary focus:outline-hidden">
                </div>

                <div>
                    <label for="first-name" class="block text-md font-medium">Prénom</label>
                    <input type="text" id="prenom" name="first-name" required class="border rounded p-2 w-full border-gray-300 focus:border-primary focus:outline-hidden">
                </div>
            </div>

            <!-- Étape 2: Informations email-->
            <div id="step-2" class="hidden flex flex-col gap-4">
                <div>
                    <label for="email" class="block text-sm font-medium">Adresse e-mail</label>
                    <input type="email" id="email" name="email" required class="border rounded p-2 w-full border-gray-300 focus:border-primary focus:outline-hidden">
                </div>

                <div>
                    <label for="email-confirm" class="block text-sm font-medium">Confirmer l'adresse e-mail</label>
                    <input type="email" id="email-confirm" name="email-confirm" required class="border rounded p-2 w-full border-gray-300 focus:border-primary focus:outline-hidden">
                </div>
            </div>

            <!-- Étape 3: Informations mot de passe -->
            <div id="step-3" class="hidden flex flex-col gap-4">
                <div>
                    <label for="password" class="block text-sm font-medium">Mot de passe</label>
                    <input type="password" id="password" name="password" required class="border rounded p-2 w-full border-gray-300 focus:border-primary focus:outline-hidden">
                </div>

                <div>
                    <label for="password-confirm" class="block text-sm font-medium">Confirmer le mot de passe</label>
                    <input type="password" id="password-confirm" name="password-confirm" required class="border rounded p-2 w-full border-gray-300 focus:border-primary focus:outline-hidden">
                </div>

                <div class="flex items-start gap-4">
                    <input type="checkbox" id="cgu" class="mt-2">
                    <label for="cgu" class="text-sm font-medium">J'accepte les <a href="/cgu" target="_blank" class="text-primary font-semibold hover:underline">Conditions Générales d'Utilisation</a> et certifie avoir pris connaissance de la politique de gestion des données à caractère personnel</label>
                </div>
            </div>

            <!-- Message d'erreur -->
            <div class="bg-red-100 rounded-lg text-red-700 p-2 flex flex-row justify-start items-center gap-4 hidden" role="alert" id="error-container-inscription">
                <span class="material-symbols-outlined"> error </span>
                <p class="font-medium" id="error-message-inscription"></p>
            </div>

            <!-- Boutons de navigation -->
            <div class="flex justify-between w-full gap-4">
                <button type="button" id="prev-step" class="w-full py-2 bg-gray-200 text-gray-400 rounded-lg">Précédent</button>
                <button type="button" id="next-step" class="w-full py-2 bg-primary text-white rounded-lg hover:bg-blue-600 cursor-pointer">Suivant</button>
                <button type="submit" id="btn-submit" class="hidden ml-auto px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 cursor-pointer">S'inscrire</button>
            </div>

            <!-- Informations de navigation -->
            <div class="flex justify-center items-center gap-2">
                <p class="text-md text-gray-500">
                    Étape <span id="current-step">1</span> sur 3
                </p>

                <div class="flex gap-1">
                    <div class="w-4 h-4 bg-primary/80 border-2 border-primary rounded-full" id="step-indicator-1"></div>
                    <div class="w-4 h-4 border-2 border-gray-300 rounded-full" id="step-indicator-2"></div>
                    <div class="w-4 h-4 border-2 border-gray-300 rounded-full" id="step-indicator-3"></div>
                </div>
            </div>

        </form>
    </div>
</div>